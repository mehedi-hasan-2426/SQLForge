{
  "name": "sqlforge",
  "private": true,
  "version": "1.0.0",
  "description": "German SQL practice with local SQLite execution, exams and browser-only progress.",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
